# Root environment variables configuration template
# HireGenius AI — Intelligent Recruitment & Coding Assessment Platform

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/hiregenius_ai

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_hiregenius_change_in_production
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=super_secret_refresh_jwt_key_hiregenius_change_in_production
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=hiregenius_cookie_secret_passphrase

# Payment Gateways
# Razorpay (India)
RAZORPAY_KEY_ID=rzp_test_hiregenius12345
RAZORPAY_KEY_SECRET=razorpay_secret_key_mock_or_sandbox
RAZORPAY_WEBHOOK_SECRET=razorpay_webhook_secret_key

# Stripe (Optional International)
STRIPE_SECRET_KEY=sk_test_hiregenius_placeholder
STRIPE_WEBHOOK_SECRET=whsec_hiregenius_placeholder

# AI Services & LLMs
AI_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=your_openai_or_groq_or_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Email Notification Service
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_smtp_user
SMTP_PASS=mock_smtp_password
EMAIL_FROM="HireGenius AI" <no-reply@hiregenius.ai>

# Code Execution Engine
CODE_EXECUTION_TIMEOUT_MS=5000
CODE_EXECUTION_MEMORY_LIMIT_MB=256

# Storage / File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
